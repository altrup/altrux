# Lambda Cloud API key — generate one at https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=

# Optional: target instance for lambda_watchdog.sh / lambda_terminate.sh.
# If unset, the watchdog finds the single active instance via the API, and
# lambda_terminate.sh (when run on an instance) matches by public IP.
# LAMBDA_INSTANCE_ID=
# LAMBDA_INSTANCE_IP=

# Optional: ssh user for watchdog probes and pulls (default: ubuntu).
# LAMBDA_SSH_USER=ubuntu

# Optional: path of the repo on the instance, relative to the ssh user's
# home. lambda_pull.sh defaults to "altrux" (i.e. ~/altrux) if unset.
# LAMBDA_REMOTE_REPO=altrux

# --- lambda_launch.sh (provision + set up a new instance) ---
# Required to launch — this project targets one GH200.
LAMBDA_INSTANCE_TYPE=gpu_1x_gh200
LAMBDA_SSH_KEY_NAME=

# Optional. Region auto-picks an available one for the instance type if unset.
# LAMBDA_REGION=us-east-1
# LAMBDA_SSH_KEY_PATH=~/.ssh/id_ed25519
# LAMBDA_INSTANCE_NAME=altrux-train
# Capacity polling: if the instance type is sold out, launch retries every
# POLL_INTERVAL seconds until it frees up (MAX_WAIT=0 = forever; else give up).
# LAMBDA_CAPACITY_POLL_INTERVAL=30
# LAMBDA_CAPACITY_MAX_WAIT=0

# --- lambda_setup.sh (configure the instance) ---
# Select the autonomous experimenter client. This does not select the
# adaptive-wake user generator.
EXPERIMENTER_AGENT=claude

# The box clones the commit at HEAD from GitHub into ~/altrux on a box/<UTC>
# branch it creates and pushes. Launch refuses a dirty tree or a HEAD origin
# does not have, and never pushes for you. The box commits and pushes code
# and notes to its branch; review and merge it here after the run. Protect
# main on GitHub so the token below cannot push to it.
# Setup leaves MODEL_NAME blank in sft/.env — the experimenter
# sets it per training leg from the notes (a rental may train several models).
# Data prep is likewise the experimenter's job, not setup's.

# Optional: one or more local checkpoint step dirs (space-separated) to put on
# the instance — one to warm-start training, several when the plan evals across
# checkpoints. launch scp's them up (checkpoints are gitignored + too big for
# GitHub) path-preserving: each lands at the same models/<model>/checkpoints/…
# path on the instance, so the path records which model it belongs to and
# several models can ship at once. Unset → training starts fresh.
# Paths must live under the repo root; relative ones resolve against it.
# Uploaded WITHOUT optimizer.pt (probes never read it); use _FULL for the
# checkpoint training resumes from — it goes up WITH optimizer.pt so resume
# keeps its optimizer state. A step dir listed in both gets its optimizer.
# LAMBDA_RESUME_CHECKPOINT="models/mamba2_2_7b_memory/checkpoints/epoch-1/step-180 models/mamba2_2_7b_memory/checkpoints/epoch-1/step-435"
# LAMBDA_RESUME_CHECKPOINT_FULL="models/mamba2_2_7b_memory/checkpoints/epoch-1/step-435"

# Optional: which sft/data/ artifacts travel between this machine and the
# instance — space-separated basename globs, used by both lambda_launch.sh
# (upload) and lambda_pull.sh (pull-back), so an artifact generated on a box
# comes home and goes back up next launch instead of being regenerated. The
# default takes the finished train_*/eval_* datasets and their scored
# *-filtered variants, and leaves pilot_*/smoke_* and raw intermediates behind.
# Empty or unset falls back to the defaults; to sync no data at all (e.g. a
# slow uplink), set a non-matching pattern like "none-*".
# LAMBDA_DATA_ARTIFACTS="train*.pt eval_*.pt"

# Optional: files, directories, or globs below the repo's .cache/ to upload to
# a new instance and pull back after it creates or changes them. Entries are
# space-separated. Missing local entries are skipped on upload but can still be
# pulled later. Select wheel tags for the rented host architecture and Python.
# Absolute paths, parent traversal, and a whole-cache wildcard are rejected.
# LAMBDA_CACHE_ARTIFACTS="lama_ckl wheels/*aarch64.whl"

# Credentials forwarded to the instance (a secure env file, not the command
# line). GITHUB_TOKEN is required: a fine-grained token with contents
# read/write on this one repo, short expiry; it lives only in the box repo's
# .git/config. HF_TOKEN authenticates gated/large HuggingFace downloads.
GITHUB_TOKEN=
# HF_TOKEN=
# Optional: origin the box fetches from and pushes to.
# LAMBDA_REPO_URL=https://github.com/altrup/altrux.git

# Optional: model for the box's Claude (e.g. opus). Unset → mirrors this
# machine's ~/.claude/settings.json model.
# CLAUDE_MODEL=

# Claude only: if set, setup auto-starts the experimenter. Generate on a
# logged-in machine with `claude setup-token`. Codex uses the selected local
# `~/.codex/auth.json` cache or credentials already present on the box.
# CLAUDE_CODE_OAUTH_TOKEN=

# Passed through to `make sync` on the instance. GH200 needs an explicit torch
# wheel. MAX_JOBS defaults to all cores.
TORCH_BACKEND=cu128
# MAX_JOBS=
