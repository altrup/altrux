# Lambda Cloud API key — generate one at https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=

# Optional: target instance for lambda_watchdog.sh / lambda_terminate.sh.
# If unset, the watchdog finds the single active instance via the API, and
# lambda_terminate.sh (when run on an instance) matches by public IP.
# LAMBDA_INSTANCE_ID=
# LAMBDA_INSTANCE_IP=

# Optional: ssh user for watchdog probes and pulls (default: ubuntu).
# LAMBDA_SSH_USER=ubuntu

# Optional: path of the repo on the instance, relative to the ssh user's
# home. lambda_pull.sh defaults to "altrux" (i.e. ~/altrux) if unset.
# LAMBDA_REMOTE_REPO=altrux

# --- lambda_launch.sh (provision + set up a new instance) ---
# Required to launch — fill these in (see the Lambda UI for valid values,
# e.g. LAMBDA_INSTANCE_TYPE=gpu_1x_gh200).
LAMBDA_INSTANCE_TYPE=
LAMBDA_SSH_KEY_NAME=

# Optional. Region auto-picks an available one for the instance type if unset.
# LAMBDA_REGION=us-east-1
# LAMBDA_SSH_KEY_PATH=~/.ssh/id_ed25519
# LAMBDA_INSTANCE_NAME=altrux-train
# Capacity polling: if the instance type is sold out, launch retries every
# POLL_INTERVAL seconds until it frees up (MAX_WAIT=0 = forever; else give up).
# LAMBDA_CAPACITY_POLL_INTERVAL=30
# LAMBDA_CAPACITY_MAX_WAIT=0
# When a launch loses the capacity race, burst-retry it BURST_ATTEMPTS times
# every BURST_INTERVAL seconds before dropping back to slow polling.
# LAMBDA_LAUNCH_BURST_ATTEMPTS=10
# LAMBDA_LAUNCH_BURST_INTERVAL=5

# --- lambda_setup.sh (configure the instance) ---
# Override the repo/model the setup uses. Defaults: clone this repo's origin
# to ~/altrux, write sft/.env with MODEL_NAME=mamba2_2_7b_memory. Data prep is
# the experimenter's job (which data, with what flags, is an experimental
# decision), not setup's.
# LAMBDA_REPO_URL=https://github.com/altrup/altrux.git
# LAMBDA_REPO_REF=main
# LAMBDA_MODEL_NAME=mamba2_2_7b_memory

# Optional: one or more local checkpoint step dirs (space-separated) to put on
# the instance — one to warm-start training, several when the plan evals across
# checkpoints. launch scp's them up (checkpoints are gitignored + too big for
# GitHub) and setup places them under models/<model>/checkpoints/<epoch>/ so
# `make resume` and the probes find them. Unset → training starts fresh.
# Relative paths resolve against the repo root, so this works from anywhere.
# LAMBDA_RESUME_CHECKPOINT="models/mamba2_2_7b_memory/checkpoints/epoch-1/step-180 models/mamba2_2_7b_memory/checkpoints/epoch-1/step-435"

# Credentials forwarded to the instance (a secure env file, not the command
# line). GITHUB_TOKEN authenticates git clone+push; HF_TOKEN authenticates
# gated/large HuggingFace downloads.
# GITHUB_TOKEN=
# HF_TOKEN=

# Optional: if set, setup auto-starts the experimenter — an autonomous
# Claude Code session in the 'experimenter' tmux — instead of leaving it for
# you to start by hand. Generate on a logged-in machine with `claude
# setup-token` (works on a Pro/Max subscription). Unset → manual attach+auth.
# CLAUDE_CODE_OAUTH_TOKEN=

# Passed through to `make sync` on the instance. GH200 (and other hosts where
# uv's `auto` backend guesses wrong) needs an explicit torch wheel. MAX_JOBS
# defaults to all cores.
# TORCH_BACKEND=cu128
# MAX_JOBS=
