# Device for model inference: auto | cuda
# auto: uses CUDA if available (recommended)
# Note: CPU is not supported — mamba_ssm uses Triton GPU kernels
DEVICE=auto

# Model package to load from the models/ directory at the repo root.
# The package defines MODEL_ID, TOKENIZER_ID, TARGET_LORA_MODULES, USER_OPEN, ASST_OPEN,
# and the Model class. To add a new model, create models/my_model/ and set MODEL_NAME=my_model.
MODEL_NAME=mamba2_780m

# Optional SFT checkpoint to load LoRA adapter weights into the base model.
# Path to a checkpoint directory (e.g. ../sft/checkpoints/mamba2_780m/step-1200).
# Leave unset to run the base model without any adapter.
# Rank and alpha are read automatically from lora_config.json in the checkpoint.
SFT_CHECKPOINT=

# Comma-separated list of allowed CORS origins.
# Add any frontend URLs that need to reach the API.
CORS_ORIGINS=http://localhost:5173

# Path to the JSONL file where revision suggestions are saved by POST /session/revise.
# Relative paths are resolved from the backend directory.
REVISE_DATA_PATH=../sft/data/revise_collected.jsonl
