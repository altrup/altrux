# Copy this file to .env and edit as needed.
# All variables are read by the backend at startup via pydantic-settings.

# HuggingFace model ID to load
CL_MODEL=ibm-granite/granite-4.0-h-micro

# Quantization: "4bit", "8bit", or leave blank for none
CL_QUANTIZE=

# Path to checkpoint directory (relative to backend/ or absolute)
CL_CHECKPOINT_DIR=../checkpoints

# Set to 1 to start fresh, ignoring any existing checkpoint
CL_NO_RESUME=0

# Learning rates
CL_CRITIC_LR=0.0001
CL_BASE_LR=0.000001

# Auto-save every N training steps (0 to disable)
CL_SAVE_EVERY=10

# Number of numbered auto-save snapshots to keep (0 = keep all)
CL_KEEP_CHECKPOINTS=1

# Comma-separated CUDA device indices, e.g. "0,1" (blank = all visible)
CL_DEVICES=

# Backend server port
CL_PORT=8000
