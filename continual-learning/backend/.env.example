# Device for model inference: auto | cuda
# auto: uses CUDA if available (recommended)
# Note: CPU is not supported — mamba_ssm uses Triton GPU kernels
DEVICE=auto

# Optional SFT checkpoint to load LoRA adapter weights into the base model.
# Path to a checkpoint directory (e.g. ../../sft/checkpoints/step-1200).
# Leave unset to run the base model without any adapter.
# Rank and alpha are read automatically from lora_config.json in the checkpoint.
SFT_CHECKPOINT=

# Comma-separated list of allowed CORS origins.
# Add any frontend URLs that need to reach the API.
CORS_ORIGINS=http://localhost:5173

# Chat-turn openers used by PUT /session/message. Must match the format the model
# was fine-tuned on (see sft/prepare_data.py). Quote the values to preserve the
# trailing space.
USER_OPEN="[USER] "
ASST_OPEN="[ASSISTANT] "
