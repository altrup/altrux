# Model to load from the models/ directory at the repo root (filename without .py).
# The model file defines MODEL_ID, TOKENIZER_ID, TARGET_LORA_MODULES, USER_OPEN, ASST_OPEN.
# To add a new model, create models/my_model.py and set MODEL_NAME=my_model.
MODEL_NAME=mamba2_780m

# The 780M memory integration arms are separate models -- pick one via
# MODEL_NAME: mamba2_780m_memory_state (gated-delta into ssm_state, the
# 2.7B design) or mamba2_780m_memory_mix (token-mix into the residual
# stream, boundary fixed at layer 16).

# mamba2_780m_memory_state only: override the default read layer (32) for
# the conditional state@16 cross cell. Checkpoints don't record this --
# note it in the run log whenever set.
# MEMORY_READ_LAYER=16

# HuggingFace access token — required for gated models.
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
